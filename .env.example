# =============================================================================
# PepperNoodles — environment configuration
#
# Copy to .env and fill in real values.  .env is gitignored; never commit it.
#   cp .env.example .env
#
# Values for the local Supabase stack are printed by:  supabase status
# =============================================================================

# --- Database (Supabase Postgres) -------------------------------------------
# Local default from `supabase start`. This project uses the 553xx port range
# (see supabase/config.toml) to avoid colliding with other local Supabase stacks.
DB_URL=jdbc:postgresql://127.0.0.1:55322/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Supabase API / Storage --------------------------------------------------
SUPABASE_URL=http://127.0.0.1:55321
# service_role key — backend only, full access, MUST NOT reach the browser
SUPABASE_SERVICE_KEY=
# anon/publishable key — safe for the frontend
SUPABASE_ANON_KEY=

# --- Backend -----------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
# Comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JWT ---------------------------------------------------------------------
# Generate with:  openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P14D

# --- Mail (account verification, password reset, admin notices) --------------
# For Gmail this is an App Password, not the account password.
# NOTE: the app password previously committed to this repo is compromised and
#       must be revoked at https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@peppernoodles.local

# --- Google reCAPTCHA v2 -----------------------------------------------------
# The keys previously committed to this repo are compromised; regenerate at
# https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

# --- LINE Messaging API ------------------------------------------------------
# The token/secret previously committed to this repo are compromised; reissue at
# https://developers.line.biz/console/
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=

# --- ECPay 綠界金流 ------------------------------------------------------------
# These are ECPay's published stage-test credentials — safe for development.
# Replace with your own production merchant credentials before going live.
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS
ECPAY_MODE=Test
ECPAY_RETURN_URL=http://localhost:8080/api/v1/payments/ecpay/callback
ECPAY_CLIENT_BACK_URL=http://localhost:3000/orders

# --- Frontend (Next.js) ------------------------------------------------------
# Only NEXT_PUBLIC_* variables are exposed to the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
